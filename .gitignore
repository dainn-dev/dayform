android

# scripts (local-only provisioning); only the root release scripts are tracked
/scripts/*
!/scripts/release-notes.sh
!/scripts/release-local.sh
!packages/mobile/scripts/
packages/mobile/scripts/*
!packages/mobile/scripts/generate-ios-certs.py

# Signing material must never be committed
*.keystore
*.jks.base64
signing-info*

