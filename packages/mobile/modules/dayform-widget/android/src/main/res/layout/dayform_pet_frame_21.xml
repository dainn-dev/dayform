<?xml version="1.0" encoding="utf-8"?>
<!-- One frame of the pet's animation, 21/40 of the way along the free width: the two empty ImageViews share the space beside the sprite by weight, so the pet reaches both edges whatever width the launcher reports. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dayform_pet_frame_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="bottom"
    android:orientation="horizontal">

    <ImageView
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="21"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/dayform_pet_frame_image"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />

    <ImageView
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="19"
        android:importantForAccessibility="no" />
</LinearLayout>
