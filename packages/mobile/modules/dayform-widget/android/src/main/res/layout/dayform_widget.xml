<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dayform_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dayform_widget_bg">

    <ImageView
        android:id="@+id/dayform_widget_photo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

    
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
    
            <TextView
                android:id="@+id/dayform_widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/dayform_widget_today"
                android:textColor="@color/dayform_widget_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />
    
            <TextView
                android:id="@+id/dayform_widget_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/dayform_widget_text_secondary"
                android:textSize="12sp" />
    
            <TextView
                android:id="@+id/dayform_widget_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/dayform_widget_pill"
                android:maxLines="1"
                android:paddingStart="9dp"
                android:paddingTop="2dp"
                android:paddingEnd="9dp"
                android:paddingBottom="2dp"
                android:textColor="@color/dayform_widget_accent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    
        <TextView
    
            android:id="@+id/dayform_widget_marks"
    
            android:layout_width="match_parent"
    
            android:layout_height="wrap_content"
    
            android:layout_marginTop="2dp"
    
            android:ellipsize="end"
    
            android:maxLines="1"
    
            android:textColor="@color/dayform_widget_accent"
    
            android:textSize="12sp"
    
            android:textStyle="bold"
    
            android:visibility="gone" />

    
        <ProgressBar
            android:id="@+id/dayform_widget_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="3dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/dayform_widget_progress"
            android:visibility="gone" />
    
        <LinearLayout
            android:id="@+id/dayform_widget_row_0"
            style="@style/DayformWidgetRowBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:visibility="gone">
    
            <ImageView
                android:id="@+id/dayform_widget_bar_0"
                style="@style/DayformWidgetBar"
                android:layout_width="3dp"
                android:layout_height="16dp"
                android:layout_marginEnd="9dp"
                android:background="@drawable/dayform_widget_bar_upcoming" />
    
            <TextView
                android:id="@+id/dayform_widget_time_0"
                style="@style/DayformWidgetTime"
                android:layout_width="44dp"
                android:layout_height="wrap_content" />
    
            <TextView
                android:id="@+id/dayform_widget_title_0"
                style="@style/DayformWidgetRowTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
    
            <TextView
                android:id="@+id/dayform_widget_duration_0"
                style="@style/DayformWidgetDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    
        <LinearLayout
            android:id="@+id/dayform_widget_row_1"
            style="@style/DayformWidgetRowBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:visibility="gone">
    
            <ImageView
                android:id="@+id/dayform_widget_bar_1"
                style="@style/DayformWidgetBar"
                android:layout_width="3dp"
                android:layout_height="16dp"
                android:layout_marginEnd="9dp"
                android:background="@drawable/dayform_widget_bar_upcoming" />
    
            <TextView
                android:id="@+id/dayform_widget_time_1"
                style="@style/DayformWidgetTime"
                android:layout_width="44dp"
                android:layout_height="wrap_content" />
    
            <TextView
                android:id="@+id/dayform_widget_title_1"
                style="@style/DayformWidgetRowTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
    
            <TextView
                android:id="@+id/dayform_widget_duration_1"
                style="@style/DayformWidgetDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    
        <LinearLayout
            android:id="@+id/dayform_widget_row_2"
            style="@style/DayformWidgetRowBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:visibility="gone">
    
            <ImageView
                android:id="@+id/dayform_widget_bar_2"
                style="@style/DayformWidgetBar"
                android:layout_width="3dp"
                android:layout_height="16dp"
                android:layout_marginEnd="9dp"
                android:background="@drawable/dayform_widget_bar_upcoming" />
    
            <TextView
                android:id="@+id/dayform_widget_time_2"
                style="@style/DayformWidgetTime"
                android:layout_width="44dp"
                android:layout_height="wrap_content" />
    
            <TextView
                android:id="@+id/dayform_widget_title_2"
                style="@style/DayformWidgetRowTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
    
            <TextView
                android:id="@+id/dayform_widget_duration_2"
                style="@style/DayformWidgetDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    
        <LinearLayout
            android:id="@+id/dayform_widget_row_3"
            style="@style/DayformWidgetRowBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:visibility="gone">
    
            <ImageView
                android:id="@+id/dayform_widget_bar_3"
                style="@style/DayformWidgetBar"
                android:layout_width="3dp"
                android:layout_height="16dp"
                android:layout_marginEnd="9dp"
                android:background="@drawable/dayform_widget_bar_upcoming" />
    
            <TextView
                android:id="@+id/dayform_widget_time_3"
                style="@style/DayformWidgetTime"
                android:layout_width="44dp"
                android:layout_height="wrap_content" />
    
            <TextView
                android:id="@+id/dayform_widget_title_3"
                style="@style/DayformWidgetRowTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
    
            <TextView
                android:id="@+id/dayform_widget_duration_3"
                style="@style/DayformWidgetDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    
        <LinearLayout
            android:id="@+id/dayform_widget_row_4"
            style="@style/DayformWidgetRowBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:visibility="gone">
    
            <ImageView
                android:id="@+id/dayform_widget_bar_4"
                style="@style/DayformWidgetBar"
                android:layout_width="3dp"
                android:layout_height="16dp"
                android:layout_marginEnd="9dp"
                android:background="@drawable/dayform_widget_bar_upcoming" />
    
            <TextView
                android:id="@+id/dayform_widget_time_4"
                style="@style/DayformWidgetTime"
                android:layout_width="44dp"
                android:layout_height="wrap_content" />
    
            <TextView
                android:id="@+id/dayform_widget_title_4"
                style="@style/DayformWidgetRowTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
    
            <TextView
                android:id="@+id/dayform_widget_duration_4"
                style="@style/DayformWidgetDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    
        <TextView
            android:id="@+id/dayform_widget_more"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="end"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="@color/dayform_widget_accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    
        <TextView
            android:id="@+id/dayform_widget_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="3"
            android:text="@string/dayform_widget_empty"
            android:textColor="@color/dayform_widget_text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>


    <!-- WidgetRenderer adds the frames of the pet's walk, one per flip, from the chosen pet's drawables. -->
    <ViewFlipper
        android:id="@+id/dayform_widget_pet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:autoStart="true"
        android:flipInterval="300"
        android:visibility="gone" />
</FrameLayout>
